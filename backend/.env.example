# Reference only: the service reads process environment, not this file automatically.
AEGIS_HTTP_ADDR=127.0.0.1:8080
# Required shared services. URL-encode credentials; enable TLS for production.
AEGIS_DATABASE_URL=postgres://aegis:CHANGE_ME@127.0.0.1:5432/aegisflow?sslmode=disable
AEGIS_DB_MAX_OPEN=20
AEGIS_DB_MAX_IDLE=5
AEGIS_REDIS_URL=redis://127.0.0.1:6379/0
# Must be identical across instances in the same deployment; separate environments.
AEGIS_REDIS_NAMESPACE=aegisflow
# Empty by default. Only list actual ingress proxy CIDRs; never 0.0.0.0/0.
AEGIS_TRUSTED_PROXIES=
# Generate an independent cryptographically random secret of at least 32 bytes.
AEGIS_JWT_SECRET=
# AES-256-GCM key for deployment-target credentials: base64 of exactly 32 bytes.
# Empty = secret storage disabled; targets without a credential still work.
# Generate with: openssl rand -base64 32
AEGIS_SECRET_KEY=
# One deployment-target connectivity probe; default 5s, must be <= 1m.
AEGIS_DEPLOY_CHECK_TIMEOUT=5s
AEGIS_ACCESS_TTL=15m
AEGIS_REFRESH_TTL=720h
# Audit retention: 0 (default) keeps every audit row forever. 24h-8760h makes the
# hourly cleanup delete older rows; deletion is opt-in so evidence is not lost by default.
AEGIS_AUDIT_RETENTION=0
# Prometheus endpoint on a SEPARATE listener (empty = disabled). It is
# unauthenticated: bind loopback or expose only through a protected proxy.
AEGIS_METRICS_ADDR=
# Upper bound for one build execution; the worker terminates the process past it (max 24h).
AEGIS_BUILD_TIMEOUT=10m
# Build isolation mode: none | user | container.
# none: developer only, runs as the service account (startup warns).
# container: one-shot sandbox per build; needs a reachable Docker runtime.
# user: Linux only, drops to AEGIS_BUILD_USER via setpriv; the service must
# start as root, otherwise startup fails closed.
AEGIS_BUILD_SANDBOX=none
# Dedicated OS account for AEGIS_BUILD_SANDBOX=user (required in that mode).
AEGIS_BUILD_USER=
# Per-build workspace cap (cloned repo plus generated files). Range 16MiB-1TiB.
AEGIS_BUILD_DISK=2g
# Clone the project repoUrl before running the command (default off).
AEGIS_BUILD_CLONE=false
# Allow file:/// and absolute local paths; only on a host whose repositories
# are trusted. Requires AEGIS_BUILD_CLONE=true.
AEGIS_BUILD_ALLOW_LOCAL_REPO=false
# Login quota per client address and minute (1-1000). Keep the production default;
# only raise it for test environments that drive several accounts from one address.
AEGIS_LOGIN_RATE_LIMIT=10
# Exact browser frontend Origin(s), comma-separated; required even with same-origin proxy.
# No wildcard/path/trailing slash. Include http://127.0.0.1:5173 only if used.
AEGIS_ALLOWED_ORIGINS=http://localhost:5173
# Explicit boolean only: false for local HTTP, MUST be true behind production HTTPS.
# Never inferred from Host / X-Forwarded-Proto. Recommended deployment: same-origin proxy.
AEGIS_COOKIE_SECURE=false
# remember=false (login default): session cookie, browser restore may retain it.
# remember=true: persistent cookie up to absolute AEGIS_REFRESH_TTL; rotation never extends it.
# Set both only when initializing the first admin; remove after initialization.
AEGIS_BOOTSTRAP_USERNAME=admin
AEGIS_BOOTSTRAP_PASSWORD=
