# Reference only: the service reads process environment, not this file automatically.
AEGIS_HTTP_ADDR=127.0.0.1:8080
# Required shared services. URL-encode credentials; enable TLS for production.
# The tenant operations CLI (go run ./cmd/tenant create|create-admin|list|disable|enable)
# reuses exactly this variable and nothing else from this file: it needs only the
# database connection (the database must already be migrated by the server).
AEGIS_DATABASE_URL=postgres://aegis:CHANGE_ME@127.0.0.1:5432/aegisflow?sslmode=disable
AEGIS_DB_MAX_OPEN=20
AEGIS_DB_MAX_IDLE=5
AEGIS_REDIS_URL=redis://127.0.0.1:6379/0
# Must be identical across instances in the same deployment; separate environments.
AEGIS_REDIS_NAMESPACE=aegisflow
# Empty by default. Only list actual ingress proxy CIDRs; never 0.0.0.0/0.
AEGIS_TRUSTED_PROXIES=
# Generate an independent cryptographically random secret of at least 32 bytes.
AEGIS_JWT_SECRET=
# Default tenant slug (multi-tenancy phase F1). Schema v18 seeds one tenant with
# the fixed id tenant_default_0000000000000001 and slug "default"; on first start
# a different value atomically renames that seeded slug (no rows are moved).
# After that the configured tenant must already exist, otherwise startup fails.
# Format: 1-32 lowercase ASCII letters, digits and inner hyphens.
AEGIS_DEFAULT_TENANT_SLUG=default
# AES-256-GCM key shared by deployment-target credentials and the independent
# secret store (/api/v1/secrets): base64 of exactly 32 bytes.
# Empty = secret storage disabled; targets without a credential still work, the
# secret store still lists/deletes metadata, and create/rotate answer 503
# "secrets are not configured". Secret values are write-only: encrypted at rest
# with a random nonce and AAD aegisflow:secrets:<id>, never returned by any API.
# A changed key makes previously sealed ciphertexts unreadable; this batch has no
# multi-key migration for the secret store (rotation only bumps key_version).
# Generate with: openssl rand -base64 32
AEGIS_SECRET_KEY=
# Retiring key used only to decrypt rows sealed before a rotation; must differ
# from AEGIS_SECRET_KEY. Keep it set until every credential has been re-saved.
AEGIS_SECRET_KEY_PREVIOUS=
# Deployment targets also carry healthPath/deployPath; those are per-target fields
# managed through the API, not environment variables.
# One deployment-target connectivity probe; default 5s, must be <= 1m.
AEGIS_DEPLOY_CHECK_TIMEOUT=5s
# One deployment execution; default 10m, must be <= 1h.
AEGIS_DEPLOY_TIMEOUT=10m
# After a 2xx deploy response the worker probes endpoint + healthPath this many
# times; 0 disables the post-deploy check (default 3, max 20).
AEGIS_DEPLOY_HEALTH_ATTEMPTS=3
# Delay between those health probes; default 2s, between 1s and 1m.
AEGIS_DEPLOY_HEALTH_INTERVAL=2s
# Environments that require approval before a deployment executes: comma-separated
# subset of development,staging,production. Empty = approvals disabled.
AEGIS_DEPLOY_APPROVAL_ENVIRONMENTS=production
# Environments that require an approved review before a deployment is created:
# comma-separated subset of development,staging,production. Empty (the default)
# disables the review gate; it composes with the approval list above (review is
# validated first, then the approval state machine).
AEGIS_DEPLOY_REQUIRE_REVIEW_ENVIRONMENTS=
# Per-project automation policy (requireReview and requiredScanVerdict) is stored
# in the database and managed through PUT /api/v1/projects/{id}/policy, not here.
# It composes on top of the environment list above and can only add requirements:
# requireReview=true requires an approved review for every environment, and
# requiredScanVerdict=passed requires the project's latest scan verdict to pass
# before a deployment or rollback is created. No project row means the default
# (both gates off), so no new environment variable is needed.
# Pending-approval lifetime; default 24h, must be between 1h and 168h.
AEGIS_APPROVAL_TTL=24h
# Optional outbound webhook URL. Empty disables delivery. HTTPS is required
# except for loopback receivers used by local integrations/tests. One receiver
# gets both approval.* and review.* events (same channel, X-AegisFlow-Event).
AEGIS_APPROVAL_WEBHOOK_URL=
# Optional HMAC-SHA256 signing key (16-256 bytes); sent as
# X-AegisFlow-Signature: sha256=<hex> over the exact JSON body.
AEGIS_APPROVAL_WEBHOOK_SECRET=
# One webhook delivery; default 5s, must be <= 30s.
AEGIS_APPROVAL_WEBHOOK_TIMEOUT=5s
# Inbound external review-result signing key (16-256 bytes). Empty keeps the
# POST /api/v1/reviews/{id}/external-results webhook closed (503); it never
# affects the outbound approval/review notification channel above.
# Third-party callers send X-AegisFlow-Timestamp (within 300s),
# X-AegisFlow-Delivery (idempotency key) and
# X-AegisFlow-Signature: sha256=<hex HMAC-SHA256(secret, timestamp + "." + body)>.
AEGIS_REVIEW_WEBHOOK_SECRET=
# Inbound signing key (16-256 bytes) for the signed scan/security-event ingest
# webhooks: POST /api/v1/projects/{id}/scans and POST /api/v1/security-events.
# Empty keeps both endpoints closed (503); it is independent from
# AEGIS_REVIEW_WEBHOOK_SECRET. Callers send the same X-AegisFlow-Timestamp
# (within 300s), X-AegisFlow-Delivery (idempotency key) and
# X-AegisFlow-Signature: sha256=<hex HMAC-SHA256(secret, timestamp + "." + body)>.
AEGIS_INGEST_WEBHOOK_SECRET=
# Optional OIDC single sign-on (P5 batch D). Leave AEGIS_OIDC_ISSUER empty to
# keep the feature completely disabled: the login page is unchanged, the config
# probe reports enabled=false and start/callback answer 503. Setting any other
# AEGIS_OIDC_* variable without the issuer fails startup on purpose (fail closed).
# Issuer must be https (loopback http is allowed only for local test providers)
# without userinfo, query or fragment. Startup fetches
# {issuer}/.well-known/openid-configuration and refuses to start if discovery,
# issuer matching or endpoint URL checks fail.
AEGIS_OIDC_ISSUER=
# Required when enabled. The client secret is optional: with it token requests
# use client_secret_post (confidential client); without it the public-client
# PKCE flow is used. Never log or commit a real secret.
AEGIS_OIDC_CLIENT_ID=
AEGIS_OIDC_CLIENT_SECRET=
# Absolute callback URL registered with the provider, for example
# https://aegis.example.com/api/v1/auth/oidc/callback (https; loopback http for tests).
AEGIS_OIDC_REDIRECT_URL=
# Space-separated scopes; must include openid. Empty uses "openid profile email".
AEGIS_OIDC_SCOPES=
# Empty/false: unknown verified emails are rejected (account_not_found).
# true: the first login may create a MEMBER account; it never creates an admin.
# Existing accounts are linked by verified email only (an empty email never matches).
AEGIS_OIDC_AUTO_PROVISION=
# Login-page SSO button label. Empty uses the default 企业单点登录.
AEGIS_OIDC_LABEL=
# Provider HTTP timeout for discovery/JWKS/token calls. Empty uses 5s; max 30s.
AEGIS_OIDC_DISCOVERY_TIMEOUT=
# Access-token lifetime; default 15m, must be <= 1h and shorter than AEGIS_REFRESH_TTL.
AEGIS_ACCESS_TTL=15m
# Absolute session lifetime; default 720h. Refresh rotation never extends it.
AEGIS_REFRESH_TTL=720h
# Audit retention: 0 (default) keeps every audit row forever. 24h-8760h makes the
# hourly cleanup delete older rows; deletion is opt-in so evidence is not lost by default.
AEGIS_AUDIT_RETENTION=0
# Prometheus endpoint on a SEPARATE listener (empty = disabled). It is
# unauthenticated: bind loopback or expose only through a protected proxy.
AEGIS_METRICS_ADDR=
# Upper bound for one build execution; the worker terminates the process past it (max 24h).
AEGIS_BUILD_TIMEOUT=10m
# Build isolation mode: none | user | container.
# none: developer only, runs as the service account (startup warns).
# container: one-shot sandbox per build; needs a reachable Docker runtime.
# user: Linux only, drops to AEGIS_BUILD_USER via setpriv; the service must
# start as root, otherwise startup fails closed.
AEGIS_BUILD_SANDBOX=none
# Dedicated OS account for AEGIS_BUILD_SANDBOX=user (required in that mode).
AEGIS_BUILD_USER=
# AEGIS_BUILD_SANDBOX=container settings (ignored by none/user): one-shot
# container image and its hard limits - CPU cores (1-64), memory size, process count (16-32768).
AEGIS_BUILD_IMAGE=alpine:3.20
AEGIS_BUILD_CPU=2
AEGIS_BUILD_MEMORY=2g
AEGIS_BUILD_PIDS=512
# Per-build workspace cap (cloned repo plus generated files). Range 16MiB-1TiB.
AEGIS_BUILD_DISK=2g
# Clone the project repoUrl before running the command (default off).
AEGIS_BUILD_CLONE=false
# Allow file:/// and absolute local paths; only on a host whose repositories
# are trusted. Requires AEGIS_BUILD_CLONE=true.
AEGIS_BUILD_ALLOW_LOCAL_REPO=false
# Login quota per client address and minute (1-1000). Keep the production default;
# only raise it for test environments that drive several accounts from one address.
AEGIS_LOGIN_RATE_LIMIT=10
# Exact browser frontend Origin(s), comma-separated; required even with same-origin proxy.
# No wildcard/path/trailing slash. Include http://127.0.0.1:5173 only if used.
AEGIS_ALLOWED_ORIGINS=http://localhost:5173
# Explicit boolean only: false for local HTTP, MUST be true behind production HTTPS.
# Never inferred from Host / X-Forwarded-Proto. Recommended deployment: same-origin proxy.
AEGIS_COOKIE_SECURE=false
# remember=false (login default): session cookie, browser restore may retain it.
# remember=true: persistent cookie up to absolute AEGIS_REFRESH_TTL; rotation never extends it.
# Set both only when initializing the first admin; remove after initialization.
AEGIS_BOOTSTRAP_USERNAME=admin
AEGIS_BOOTSTRAP_PASSWORD=
